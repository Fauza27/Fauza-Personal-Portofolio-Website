# =============================================================================
# Environment Variables for Fauza Portfolio
# Copy this file to ".env" (or ".env.local") and fill in the values below.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. CONTACT FORM (Google Apps Script)
# ---------------------------------------------------------------------------
# Google Apps Script Web App URL that receives contact form submissions.
# Setup: See google-apps-script/contact-form.gs for step-by-step instructions.
# Example: https://script.google.com/macros/s/AKfycb.../exec
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# 2. AI CHAT ENDPOINT
# ---------------------------------------------------------------------------
# Path to the Cloudflare Pages Function that proxies OpenAI.
# Default works out of the box — only change if you move the function.
NEXT_PUBLIC_CHAT_ENDPOINT=/api/chat

# ---------------------------------------------------------------------------
# 3. OPENAI API KEY (⚠️ NOT SET HERE!)
# ---------------------------------------------------------------------------
# The OpenAI key is a SERVER-SIDE secret. Never put it in this file.
#
# For LOCAL testing:
#   Copy .dev.vars.example → .dev.vars and fill in:
#     OPENAI_API_KEY=sk-your-key-here
#   Then run: npx wrangler pages dev out
#
# For PRODUCTION:
#   Set it in Cloudflare Pages → Settings → Environment variables
# =============================================================================
